{
  "name": "gitlab-ci-dashboard",
  "version": "6.5.2",
  "description": "📊 Dashboard for monitoring GitLab CI builds and pipelines for TV. This project is based on gitlab-ci-monitor by globo.com",
  "author": "Emiliano Barbosa <emilianoeloi@gmail.com>",
  "contributors": [
    {
      "name": "Marek Ganko",
      "url": "https://github.com/marek-ganko"
    },
    {
      "name": "Sajjad Shirazy",
      "url": "https://github.com/sajjad-shirazy"
    },
    {
      "name": "Sam Skjonsberg",
      "url": "https://github.com/codeviking"
    }
  ],
  "license": "MIT",
  "homepage": "https://github.com/ci-dashboard/gitlab-ci-dashboard",
  "bugs": "https://github.com/ci-dashboard/gitlab-ci-dashboard/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/ci-dashboard/gitlab-ci-dashboard"
  },
  "scripts": {
    "dev": "webpack serve --config build/webpack.dev.conf.js",
    "start": "npm run dev",
    "unit": "jest --testPathPattern=test/unit/specs --coverage",
    "test": "npm run unit",
    "lint": "eslint --ext .js,.vue src test/unit/specs",
    "build": "rm -rf standalone dist && mkdir standalone && node build/build.js && cp -R dist/* standalone/ && cp index.js standalone/",
    "report-coverage": "codecov",
    "server": "http-server ./dist",
    "gitlab-mocked-server": "node mocked_gitlab/server.js",
    "deploy": "npm run build && ./scripts/deploy_to_git.sh 'dist' `git config --get remote.origin.url` 'gh-pages'"
  },
  "keywords": [
    "gitlab",
    "ci",
    "gitlab-ci",
    "dashboard",
    "monitor",
    "pipeline",
    "tv"
  ],
  "bin": {
    "gitlab-ci-dashboard": "./bin/gitlab-ci-dashboard",
    "gitlab-ci-dashboard-migration": "./bin/gitlab-ci-dashboard-migration"
  },
  "dependencies": {
    "commander": "2.13.0",
    "cors": "2.8.4",
    "express": "4.16.2",
    "fitch": "0.11.0",
    "fs": "0.0.1-security",
    "json-beautify": "1.0.1",
    "moment": "2.20.1",
    "opn": "5.2.0",
    "semver-regex": "1.0.0",
    "semver-sort": "0.0.4",
    "vue": "2.5.13"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/eslint-parser": "^7.23.0",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-object-rest-spread": "^7.20.7",
    "@babel/plugin-transform-runtime": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/runtime": "^7.23.0",
    "@vue/vue2-jest": "^29.2.6",
    "autoprefixer": "^10.4.16",
    "babel-jest": "^29.7.0",
    "babel-loader": "^9.1.3",
    "chalk": "^4.1.2",
    "codecov": "3.7.1",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.8.1",
    "css-minimizer-webpack-plugin": "^5.0.1",
    "eslint": "^8.54.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-n": "^16.3.1",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-vue": "^9.18.1",
    "eslint-webpack-plugin": "^4.0.1",
    "html-webpack-plugin": "^5.5.4",
    "http-server": "^14.1.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "mini-css-extract-plugin": "^2.7.6",
    "moxios": "0.4.0",
    "node-notifier": "^10.0.1",
    "ora": "^5.4.1",
    "portfinder": "^1.0.32",
    "postcss": "^8.4.31",
    "postcss-import": "^15.1.0",
    "postcss-loader": "^7.3.3",
    "rimraf": "^5.0.5",
    "semver": "^7.5.4",
    "shelljs": "0.8.5",
    "sinon": "^17.0.1",
    "vue-loader": "^15.11.1",
    "vue-style-loader": "^4.1.3",
    "vue-template-compiler": "2.5.13",
    "webpack": "^5.89.0",
    "webpack-bundle-analyzer": "^4.10.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.0",
    "webpack-merge": "^5.10.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "vue"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "transform": {
      "^.+\\.js$": "babel-jest",
      ".*\\.(vue)$": "@vue/vue2-jest"
    },
    "setupFiles": [
      "<rootDir>/test/unit/setup"
    ],
    "coverageDirectory": "<rootDir>/test/unit/coverage",
    "collectCoverageFrom": [
      "src/**/*.{js,vue}",
      "!**/node_modules/**"
    ],
    "testEnvironment": "jsdom",
    "verbose": true
  },
  "engines": {
    "node": ">= 18.12.0",
    "npm": ">= 8.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 8"
  ]
}
