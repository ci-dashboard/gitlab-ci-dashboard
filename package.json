{
  "name": "gitlab-ci-dashboard",
  "version": "7.0.0-alpha.1",
  "description": "📊 Dashboard for monitoring GitLab CI builds and pipelines for TV. This project is based on gitlab-ci-monitor by globo.com",
  "author": "Emiliano Barbosa <emilianoeloi@gmail.com>",
  "contributors": [
    {
      "name": "Marek Ganko",
      "url": "https://github.com/marek-ganko"
    },
    {
      "name": "Sajjad Shirazy",
      "url": "https://github.com/sajjad-shirazy"
    },
    {
      "name": "Sam Skjonsberg",
      "url": "https://github.com/codeviking"
    }
  ],
  "license": "MIT",
  "homepage": "https://github.com/ci-dashboard/gitlab-ci-dashboard",
  "bugs": "https://github.com/ci-dashboard/gitlab-ci-dashboard/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ci-dashboard/gitlab-ci-dashboard.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "prepublishOnly": "npm run build && npm run build:server && npm test",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "server": "tsx server/index.ts",
    "gitlab-mocked-server": "node mocked_gitlab/server.js"
  },
  "keywords": [
    "gitlab",
    "ci",
    "gitlab-ci",
    "dashboard",
    "monitor",
    "pipeline",
    "tv"
  ],
  "bin": {
    "gitlab-ci-dashboard": "bin/gitlab-ci-dashboard",
    "gitlab-ci-dashboard-migration": "bin/gitlab-ci-dashboard-migration"
  },
  "files": [
    "dist/",
    "server-dist/",
    "bin/",
    "migration/",
    "static/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "commander": "^12.0.0",
    "express": "^4.21.0",
    "open": "^10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/express": "^4.17.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/semver": "^7.5.0",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "@vitest/coverage-v8": "^4.1.8",
    "date-fns": "^4.1.0",
    "eslint": "^9.20.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "jsdom": "^25.0.0",
    "prettier": "^3.5.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "semver": "^7.6.0",
    "tsx": "^4.0.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.24.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">= 18.0.0",
    "npm": ">= 10.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 8"
  ]
}
